# ==========================================================================
# Star Garden CRM — environment template
# --------------------------------------------------------------------------
# Copy to `.env.local` for development, or paste into your Vercel project's
# Environment Variables screen for production. NEVER commit a filled-in file.
#
# Only variables prefixed NEXT_PUBLIC_ are shipped to the browser. Everything
# else is server-only and must never be imported from a Client Component
# (AGENTS.md §15, §18).
#
# Nothing here is required to *build* the app. Supabase, Tigris and Meta are
# each validated lazily at first use, so you can deploy the shell first and
# fill credentials in as you obtain them.
# ==========================================================================


# --------------------------------------------------------------------------
# 1. APPLICATION
# --------------------------------------------------------------------------

# Canonical public origin, no trailing slash. Used to build absolute links in
# notifications and the Meta webhook callback URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shown in the UI header / page titles.
NEXT_PUBLIC_APP_NAME="Star Garden CRM"

# "development" | "production". Controls HTTPS enforcement and cookie flags.
NODE_ENV="development"


# --------------------------------------------------------------------------
# 2. SUPABASE  — database, auth, RLS  (AGENTS.md §4.2)
#
# HOW TO GET THESE:
#   Supabase Dashboard -> your project -> Project Settings -> API
#     * Project URL              -> NEXT_PUBLIC_SUPABASE_URL
#     * Project API keys: anon   -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#     * Project API keys: service_role -> SUPABASE_SERVICE_ROLE_KEY
#   Project Settings -> Database -> Connection string (URI, "Session pooler")
#                                -> SUPABASE_DB_URL   (migrations only)
# --------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Safe to expose. RLS is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME"

# !! SERVER ONLY — bypasses RLS. Never expose to the browser. Used strictly for
# system work that has no user session: Meta webhook intake, public website
# enquiries, audit-log writes and the reminder cron (§7.5, §18).
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME"

# Direct Postgres URI. Only needed by the Supabase CLI to push migrations —
# the running app never uses it.
SUPABASE_DB_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"


# --------------------------------------------------------------------------
# 3. TIGRIS OBJECT STORAGE — all uploaded binary files (AGENTS.md §4.3)
#
# HOW TO GET THESE:
#   https://storage.new  (or Fly.io -> Tigris) -> create a bucket
#   Bucket visibility MUST be **private**. Public buckets violate §15/§18.
#   Then: Create Access Key -> copy the key id and secret exactly once.
#
# Tigris is S3-compatible, so the standard AWS SDK is used with a custom
# endpoint. Files are uploaded browser -> Tigris directly via short-lived
# presigned URLs; bytes never pass through the CRM server.
# --------------------------------------------------------------------------

TIGRIS_BUCKET_NAME="stargarden-crm-files"
TIGRIS_ENDPOINT_URL="https://t3.storage.dev"
TIGRIS_REGION="auto"
TIGRIS_ACCESS_KEY_ID="tid_REPLACE_ME"

# !! SERVER ONLY — full read/write on the private bucket.
TIGRIS_SECRET_ACCESS_KEY="tsec_REPLACE_ME"

# Lifetime in seconds for presigned UPLOAD URLs. Keep short (§15).
TIGRIS_UPLOAD_URL_TTL_SECONDS="300"

# Lifetime in seconds for presigned PREVIEW/DOWNLOAD URLs. Keep short, and
# never persist a generated URL in the database (§15).
TIGRIS_DOWNLOAD_URL_TTL_SECONDS="120"


# --------------------------------------------------------------------------
# 4. META (FACEBOOK / INSTAGRAM) LEAD ADS — (AGENTS.md §14)
#
# HOW TO GET THESE:
#   developers.facebook.com -> your App
#     * App ID / App Secret        -> Settings -> Basic
#     * Page Access Token          -> Graph API Explorer, select the Star Garden
#       Page, grant: leads_retrieval, pages_show_list, pages_read_engagement,
#       pages_manage_metadata. Then exchange for a LONG-LIVED token.
#     * Verify token               -> any random string YOU invent; paste the
#       same value into the Meta webhook config screen.
#
#   Webhook callback URL to register with Meta:
#     https://YOUR-DOMAIN/api/meta/webhook
#   Subscribe the Page to the `leadgen` field.
#
# If these are absent the CRM still runs — Meta intake is simply disabled, and
# manual + website leads keep working (§14, last bullet).
# --------------------------------------------------------------------------

META_APP_ID="REPLACE_ME"

# !! SERVER ONLY — used to validate the X-Hub-Signature-256 header on every
# incoming webhook so forged payloads are rejected.
META_APP_SECRET="REPLACE_ME"

# !! SERVER ONLY — the string Meta echoes back during GET webhook verification.
META_WEBHOOK_VERIFY_TOKEN="pick-a-long-random-string"

# !! SERVER ONLY — long-lived Page access token used to fetch full lead data
# from the Graph API once a leadgen event arrives.
META_PAGE_ACCESS_TOKEN="REPLACE_ME"

# Restricts which Page IDs the webhook will accept, comma-separated. Leave
# blank to accept every page this app is subscribed to.
META_ALLOWED_PAGE_IDS=""

# Graph API version used for lead retrieval.
META_GRAPH_API_VERSION="v21.0"


# --------------------------------------------------------------------------
# 5. SCHEDULED JOBS — follow-up / due-date reminders (AGENTS.md §13)
#
# Vercel Cron (see vercel.json) calls /api/cron/reminders. The route rejects
# any request without this bearer secret, so it cannot be triggered publicly.
# Generate with:  openssl rand -hex 32
# --------------------------------------------------------------------------

CRON_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX"


# --------------------------------------------------------------------------
# 6. FILE UPLOAD POLICY (AGENTS.md §5.3)
#
# Defaults are also stored in the `app_settings` table so an Admin can change
# them at runtime without a redeploy. These env values are the fallback used
# when the settings row is missing.
# --------------------------------------------------------------------------

MAX_UPLOAD_SIZE_MB="50"


# --------------------------------------------------------------------------
# 7. PUBLIC ENQUIRY FORM — anti-spam (AGENTS.md §11.8, §15)
#
# The marketing site posts to /api/public/enquiry. Requests are rate limited
# per IP and carry a honeypot field. Optionally add Cloudflare Turnstile:
# leave the secret blank to disable captcha verification entirely.
# --------------------------------------------------------------------------

NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Comma-separated origins allowed to POST the public enquiry endpoint (CORS).
PUBLIC_ENQUIRY_ALLOWED_ORIGINS="http://localhost:5173,https://stargardens.in"

# Max public enquiry submissions per IP per hour.
PUBLIC_ENQUIRY_RATE_LIMIT_PER_HOUR="8"
