# Local Supabase Edge Function secrets only.
# Production values are set with `supabase secrets set`; do not copy these into
# the Next.js `.env`, because the application runtime does not consume them.

META_APP_SECRET="REPLACE_ME"
META_WEBHOOK_VERIFY_TOKEN="pick-a-long-random-string"
META_PAGE_ACCESS_TOKEN="REPLACE_ME"
META_ALLOWED_PAGE_IDS="PAGE_ID_ONE,PAGE_ID_TWO"

META_AD_ACCOUNT_ID="act_REPLACE_ME"
META_ADS_ACCESS_TOKEN="REPLACE_ME"

# Shared with Supabase Vault as `meta_sync_internal_secret` for pg_cron calls.
META_SYNC_INTERNAL_SECRET="REPLACE_WITH_A_LONG_RANDOM_VALUE"
